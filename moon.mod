name = "moonbit-hack/copybook"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbit-hack/copybook"

license = "Apache-2.0"

keywords = ["cobol", "copybook", "ebcdic", "fixed-record", "legacy-data"]

preferred_target = "wasm"

description = "COBOL copybook compiler: fixed-length EBCDIC/COMP-3 record decoding into typed rows, with layout maps and round-trip encoding."

import {
  "moonbitlang/x@0.5.5",
}
